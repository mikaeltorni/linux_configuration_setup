[Unit]
Description=Activate staged passwordless GNOME keyring
DefaultDependencies=no
After=-.mount
Before=gnome-keyring-daemon.socket gnome-keyring-daemon.service
ConditionPathExists=%h/.local/state/linux-configuration-setup/passwordless-keyring-pending/ready

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/linux-configuration-setup/activate-passwordless-keyring

[Install]
WantedBy=sockets.target
